{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build WindowsUpdateRepairTool",
			"type": "shell",
			"command": "dotnet build",
			"args": [
				"c:\\Users\\muril\\Downloads\\WindowsUpdateRepairTool\\WindowsUpdateRepairTool.csproj"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Publish WindowsRepairTools (x64)",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"publish",
				"-c",
				"Release",
				"-r",
				"win-x64",
				"--self-contained",
				"true",
				"/p:PublishSingleFile=true"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Build Installer (Inno Setup)",
			"type": "shell",
			"command": "C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe",
			"args": [
				"WindowsRepairTools.iss"
			],
			"problemMatcher": []
		},
		{
			"label": "Publish + Build Installer",
			"dependsOn": [
				"Publish WindowsRepairTools (x64)",
				"Build Installer (Inno Setup)"
			],
			"dependsOrder": "sequence"
		}
	]
}